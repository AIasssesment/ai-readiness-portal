# Copy to .env / .env.local and fill values.
# Do not commit real secrets.

# App
AUTH_SECRET=
DATABASE_URL=
APP_URL=http://localhost:3001

# Nest BFF (server). Normalized to .../v1 by lib/api/client.ts
API_URL=http://localhost:3000
# BACKEND_URL=http://localhost:3000

# Browser → Nest for payments/reports client calls only
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-only: Next Route Handlers → Nest trusted headers
# Must match Nest INTERNAL_API_TOKEN. Never expose to the browser.
INTERNAL_API_TOKEN=

# Public app origin (Job Risk Monobank return URLs)
APP_URL=http://localhost:3001
